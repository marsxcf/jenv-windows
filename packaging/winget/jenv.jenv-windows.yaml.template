# WinGet manifest template for jenv-windows.
#
# At release time the GitHub Actions workflow (.github/workflows/release.yml)
# renders this into the final manifest, filling in PackageVersion, InstallerUrl
# and InstallerSha256. The first generated manifest is submitted manually to
# microsoft/winget-pkgs; automated updates can be enabled after that.
#
# Submission: https://learn.microsoft.com/en-us/windows/package-manager/package/repository
# Validate locally:   winget validate <rendered.yaml>
# Test locally:       winget install -m <rendered.yaml>
#
# First release is a manual PR to winget-pkgs (new PackageIdentifier). Later
# versions can be automated via the winget-pkgs-automation action.

# yaml-language-server: $schema=https://aka.ms/winget-manifest.singleton.1.12.0.schema.json

PackageIdentifier: jenv-windows.jenv-windows
PackageVersion: __VERSION__
PackageLocale: en-US

Publisher: jenv-windows contributors
PublisherUrl: https://github.com/marsxcf/jenv-windows
PublisherSupportUrl: https://github.com/marsxcf/jenv-windows/issues
PrivacyUrl: https://github.com/marsxcf/jenv-windows/security/policy
Author: jenv-windows contributors

PackageName: jenv-windows
PackageUrl: https://github.com/marsxcf/jenv-windows
License: MIT
LicenseUrl: https://github.com/marsxcf/jenv-windows/blob/main/LICENSE
Copyright: (c) 2026 jenv-windows contributors. MIT license.
ShortDescription: JDK version selector for Windows PowerShell 7
Description: |-
  jenv-windows manages already-installed JDKs and switches the active JDK in the
  current PowerShell 7 session across shell / local (.java-version) / global /
  system scopes. A Windows-native reimagining of jenv. It does not download or
  install Java.

Tags:
  - Java
  - JDK
  - jenv
  - PowerShell
  - Windows
  - JavaVersion

Commands:
  - jenv

Dependencies:
  PackageDependencies:
    - PackageIdentifier: Microsoft.PowerShell
      MinimumVersion: 7.4.0

Installers:
  - Architecture: x64
    InstallerType: inno
    InstallerUrl: https://github.com/marsxcf/jenv-windows/releases/download/v__VERSION__/jenv-windows-__VERSION__-setup.exe
    InstallerSha256: __SHA256__
    Scope: user
    UpgradeBehavior: install
    ProductCode: '{585CEFF5-B3E1-4F24-AD94-412EB1073E5E}_is1'

ManifestType: singleton
ManifestVersion: 1.12.0
