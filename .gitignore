### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### VS Code
# VSCode settings (keep shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### jenv-windows
# Build artifacts
artifacts/
build-output/

# Test results
test-results/
TestResults/

# Local runtime data (never commit a user's JDK registry)
.jenv/
.jenv-windows/

# Inno Setup build output
packaging/Output/
*.exe.tmp